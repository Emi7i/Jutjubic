<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Cache-specific Logger -->
    <logger name="org.hibernate.cache" level="OFF" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="org.hibernate.stat" level="OFF" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Application-specific Cache Services -->
    <logger name="isa.jutjub.service" level="OFF" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Root Logger -->
    <root level="OFF">
    </root>
</configuration>
